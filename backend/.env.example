# Server Configuration
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hotel_reliance_db?schema=public"

# Redis Cache & Concurrency Lock (Optional - in-memory fallback enabled)
REDIS_URL="redis://localhost:6379"

# JWT Authentication
JWT_SECRET="reliance-super-secret-jwt-key-32-chars-minimum"
JWT_EXPIRES_IN="7d"
REFRESH_TOKEN_SECRET="reliance-super-secret-refresh-key-32-chars"

# Razorpay Payment Gateway (Test Mode)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="rzp_secret_placeholder"
RAZORPAY_WEBHOOK_SECRET="whsec_placeholder"

# Notification Services
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
RESEND_API_KEY=""
